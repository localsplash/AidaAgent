# A deployment states only how to reach the settings store. Every other value is
# a PlatformConfig row (cfg_tbl_Setting) resolved at start as app=aida-agent >
# app=aida > app=*; a same-named variable here is ignored. See README "Settings".
NOCODB_BASE_URL=
NOCODB_API_TOKEN=

# Internal application diagnostics listener; code defaults, state only to change.
# AIDA_STATUS_HOST=0.0.0.0
# AIDA_STATUS_PORT=8082

# Optional: attach to an existing reverse-proxy Docker network (compose.proxy.yaml)
# so the proxy can reach /healthz by container name. Compose reads these from .env.
# COMPOSE_FILE=compose.yaml:compose.proxy.yaml
# AIDA_PROXY_NETWORK=npm_network
