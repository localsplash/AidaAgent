# Use the SAME LiveKit project as OfficePulse; do not commit real credentials.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match OfficePulse LIVEKIT_AGENT_NAME. Stop the previous aida-prime worker
# before assigning this name, or use aida-prime-dev in BOTH deployments.
AIDA_AGENT_NAME=aida-prime-bootstrap-dev

# Explicit LiveKit Inference choices; per-call metadata cannot override these.
AIDA_STT_MODEL=deepgram/nova-3-general
AIDA_LLM_MODEL=openai/gpt-4.1-mini
AIDA_TTS_MODEL=cartesia/sonic-3
AIDA_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# OfficePulse's call-scoped bootstrap API; HTTPS origin only, no path or query.
# Requires upstream native call admission; current OfficePulse dev returns FALLBACK.
AIDA_BOOTSTRAP_URL=https://officepulse.example.com
# Must match the LiveKit trunk header-to-attribute mapping for X-Aida-Route-Token.
AIDA_ROUTE_TOKEN_ATTRIBUTE=sip.aidaRouteToken
# Total join + SIP wait + authorization + session start + ready deadline (1-60 seconds).
AIDA_BOOTSTRAP_TIMEOUT_SECONDS=30
